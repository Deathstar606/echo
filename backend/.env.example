# ==============================================================================
# MaxiText AI Studio Backend — Environment Variables Template
# ==============================================================================

# Server Configuration
PORT=3000
HOST=localhost
NODE_ENV=development

# PostgreSQL Database Connection
# Local example: postgresql://postgres:password@localhost:5432/maxitext_db
# Cloud example (Aiven / Supabase): postgres://user:password@host:port/defaultdb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maxitext_db

# Database SSL Configuration
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_SSL_CA_PATH=

# Upload and Retrieval Limits
MAX_UPLOAD_SIZE_BYTES=2097152
PROMPT_TOP_K=5
CONVERSATION_HISTORY_LIMIT=20

# Google AI Studio (Gemini API) Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PROJECT_NAME=MaxiText-AI-Studio
GEMINI_PROJECT_NUMBER=1234567890
GEMINI_MODEL=gemini-2.5-flash

# Gmail SMTP Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
MAIL_FROM="MaxiText AI Studio" <your_email@gmail.com>

# Optional: Set to true to test bulk sending locally without delivering real emails
SMTP_TEST_MODE=false
