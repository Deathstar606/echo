# Server Configuration
PORT=3000
HOST=localhost
NODE_ENV=development

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/echo_support
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_SSL_CA_PATH=

# Upload and Retrieval Limits
MAX_UPLOAD_SIZE_BYTES=2097152
PROMPT_TOP_K=5
CONVERSATION_HISTORY_LIMIT=20

# Google AI Studio (Gemini API) Configuration
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_PROJECT_NAME=projects/your-project-number
GEMINI_PROJECT_NUMBER=your-project-number
GEMINI_MODEL=gemini-3.5-flash-lite

# Gmail SMTP Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM=your-email@gmail.com

# Optional: Set SMTP_TEST_MODE=true to simulate email sending locally without real SMTP delivery
SMTP_TEST_MODE=false
