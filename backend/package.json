{
  "name": "echo-support-assistant-backend",
  "version": "1.0.0",
  "description": "Phase 1 Customer-Support Assistant Backend - CSV knowledge import and contextual prompt generation",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0 <=24.x"
  },
  "scripts": {
    "start": "node --import tsx src/server.js",
    "dev": "nodemon --exec \"node --import tsx\" src/server.js",
    "db:init": "node db/init.js",
    "test": "node --import tsx --test test/workflow.test.js test/sheetWorkflow.test.js test/universalSheet.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.2.1",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "nodemon": "^3.1.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
